{
  "debugTint": true,
  "tintColor": "#c9b896",
  "_doc": "MAIN glyph grid (js/glyph/GlyphPreview.vue). Units = SVG slice units (ka slice = 540 tall); CSS scales them via --u (see --glyph-h in css/styles.css). Grid: columns = root | tsheg | shad (tsheg/shad columns only exist when shown); rows = vowelAbove | main | vowelBelow. All parts are separate SVG files; root cell is fixed rootW x rootH; cells use align-items:start so shad top == root crossbar top (root is pulled up by perGlyph.crossbarTop). debugTint:true paints vowel+shad in tintColor (cream).",
  "grid": {
    "colGap": 24,
    "padding": 20,
    "aboveH": 280,
    "belowH": 200,
    "mainH": 540
  },
  "cells": {
    "root": { "w": 320, "h": 540, "dx": 0, "dy": 0 },
    "vowel": { "gap": 70, "belowGap": 12, "dx": 0, "dy": 0 },
    "tsheg": { "w": 64, "yFraction": 0, "dx": 0, "dy": -50 },
    "shad": { "w": 76, "dx": 0, "dy": -50 }
  },
  "perVowel": {
    "_doc": "Per-vowel overrides. gap/dy = above-vowel spacing; belowGap/dy = below-vowel spacing; dx = horizontal nudge. Falls back to cells.vowel values.",
    "i": { "gap": 70, "dx": 0, "dy": 0 },
    "u": { "belowGap": 12, "dx": 0, "dy": 0 },
    "e": { "gap": 70, "dx": 0, "dy": 0 },
    "o": { "gap": 70, "dx": 20, "dy": 0 }
  },
  "fallbackRoot": {
    "heightFraction": 0.85
  },
  "perGlyph": {
    "_doc": "Per-wylie tweaks. crossbarTop: distance of crossbar top below slice top, in slice units. Root is shifted up by crossbarTop*scale so crossbar aligns with main row top. Tune visually with ?shad=1. dx/dy nudge the root only.",
    "ka":  { "dx": 0, "dy": 0, "crossbarTop": 0, "scale": 1 },
    "kha": { "dx": 0, "dy": 0, "crossbarTop": 0, "scale": 1 },
    "ga":  { "dx": 0, "dy": 0, "crossbarTop": 0, "scale": 1 },
