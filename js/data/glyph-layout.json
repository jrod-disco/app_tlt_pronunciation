    "nya": { "dx": 0, "dy": 0, "crossbarTop": 0 },
    "ta":  { "dx": 0, "dy": 0, "crossbarTop": 0 },
    "tha": { "dx": 0, "dy": 0, "crossbarTop": 0 },
    "da":  { "dx": 0, "dy": 0, "crossbarTop": 0 },
