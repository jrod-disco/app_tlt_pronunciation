    "pha": { "dx": 0, "dy": 0, "crossbarTop": 0 },
    "ba":  { "dx": 0, "dy": 0, "crossbarTop": 0 },
    "ma":  { "dx": 0, "dy": 0, "crossbarTop": 0 },
    "tsa": { "dx": 20, "dy": 0, "crossbarTop": 90, "scale": 1.15, "vowelGap": 150 },
    "tsha":{ "dx": 20, "dy": 0, "crossbarTop": 90, "scale": 1.11,  "vowelGap": 150 },
    "dza": { "dx": 30, "dy": 0, "crossbarTop": 90, "scale": 1.1,  "vowelGap": 150 },
    "wa":  { "dx": 0, "dy": 0, "crossbarTop": 0 },
